# Tokamak ZKP Channel Manager - Environment Variables
# Copy this file to .env.local and update the values

# ============================================================================
# Blockchain Configuration
# ============================================================================

# Default network for channel operations
# Options: sepolia, mainnet, localhost
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia

# ============================================================================
# Application Settings
# ============================================================================

# Enable debug mode (shows console logs)
NEXT_PUBLIC_DEBUG_MODE=false

# Auto-refresh session list interval (milliseconds)
NEXT_PUBLIC_SESSION_REFRESH_INTERVAL=10000

# ============================================================================
# Development Settings
# ============================================================================

# Show development console settings
NEXT_PUBLIC_SHOW_DEV_CONSOLE=true

# ============================================================================
# Notes
# ============================================================================
# 
# Copy this file to .env.local:
# cp env.example .env.local
#
# After updating .env.local, restart your development server:
# npm run dev

# ============================================================================
# Contract Addresses
# ============================================================================

# Rollup Bridge Contract Addresses
NEXT_PUBLIC_ROLLUP_BRIDGE_CORE_ADDRESS=0x04C0A9366280A4B6bcE0f01d5D18014d1Bd03845
NEXT_PUBLIC_ROLLUP_BRIDGE_DEPOSIT_MANAGER_ADDRESS=0x1B6073D620b8977D4760F5a36f1Be0ceB3A21fAE
NEXT_PUBLIC_ROLLUP_BRIDGE_PROOF_MANAGER_ADDRESS=0xCfD17915Fe378f49c4bF574d63F3De5c7AFD78c7
NEXT_PUBLIC_ROLLUP_BRIDGE_WITHDRAW_MANAGER_ADDRESS=0x0B9bE3471eEB400Dcf0872D7795308a959E3FDa8
NEXT_PUBLIC_ROLLUP_BRIDGE_ADMIN_MANAGER_ADDRESS=0x845C23BA92cE8994079eAB7E7fD078e5269F647d

# Verifier Contract Addresses
NEXT_PUBLIC_VERIFIER_ADDRESS=0xF43C2a14A8e5Ab3FC8740ea4AABc45010ED9fb52
NEXT_PUBLIC_GROTH16_VERIFIER_16_ADDRESS=0x27f453C0f7eAC419A390edaae6b0ABA64D6490c9
NEXT_PUBLIC_GROTH16_VERIFIER_32_ADDRESS=0xCF85A85856237C8B1E9FE43e117ca8245c2AbE6A
NEXT_PUBLIC_GROTH16_VERIFIER_64_ADDRESS=0x9192Ab6CCe1FF89393153BD54CE95F7aEE0Cf831
NEXT_PUBLIC_GROTH16_VERIFIER_128_ADDRESS=0xdb70a38547f6Bcc655786b2cf19D0f34e7B3ebED
NEXT_PUBLIC_ZECFROST_ADDRESS=0x910eEE98A93d54AD52694cBf2B45B1534C8c8D10

# Token Contract Addresses (Sepolia testnet)
NEXT_PUBLIC_TON_TOKEN_ADDRESS=0xa30fe40285B8f5c0457DbC3B7C8A280373c40044
NEXT_PUBLIC_USDT_TOKEN_ADDRESS=0x42d3b260c761cD5da022dB56Fe2F89c4A909b04A
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_ETH_TOKEN_ADDRESS=0x0000000000000000000000000000000000000001

# ============================================================================
# API Keys
# ============================================================================

# Alchemy API Key
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID
